    "# 1. Quantitative Mapping\n",
    "# We convert categorical labels into a standardized numerical range:\n",
    "# Bullish (+1), Bearish (-1), and Neutral (0)\n",
    "df_idx = df.copy()\n",
    "sentiment_map = {'Bullish': 1, 'Bearish': -1, 'Neutral': 0}\n",
    "df_idx['sent_score'] = df_idx['Sentiment'].map(sentiment_map)\n",
    "\n",
    "# 2. Time-Series Resampling and Smoothing\n",
    "# We calculate the daily mean sentiment score and apply a 7-day rolling window\n",
    "# to identify lower-frequency behavioral trends.\n",
    "rolling_sentiment = (df_idx.set_index('Market_Time')['sent_score']\n",
    "                     .resample('D')\n",
    "                     .mean()\n",
    "                     .rolling(window=7)\n",
    "                     .mean())\n",
    "\n",
    "# 3. Technical Visualization: Sentiment Index Plot\n",
    "plt.figure(figsize=(15, 6))\n",
    "rolling_sentiment.plot(color='darkgreen', linewidth=2, label='7-Day Rolling Sentiment')\n",
    "\n",
    "# Reference Level: The zero-line represents 'Market Neutrality'\n",
    "plt.axhline(0, color='black', linestyle='--', alpha=0.5)\n",
    "\n",
    "# Visualizing Sentiment Regimes\n",
    "# Green shading represents periods of net optimism; Red shading represents net anxiety.\n",
    "plt.fill_between(rolling_sentiment.index, rolling_sentiment, 0, \n",
    "                 where=(rolling_sentiment >= 0), color='#90EE90', alpha=0.3, label='Optimism')\n",
    "plt.fill_between(rolling_sentiment.index, rolling_sentiment, 0, \n",
    "                 where=(rolling_sentiment < 0), color='#CD5C5C', alpha=0.3, label='Anxiety')\n",
    "\n",
    "# Technical Labeling and Axes Description\n",
    "plt.title('EDA: 7-Day Rolling Sentiment Index (Market Optimism Proxy)', fontsize=16, fontweight='bold')\n",
    "plt.xlabel('Market Date (Timeline 2020-2022)', fontsize=12)\n",
    "plt.ylabel('Net Sentiment Score (-1 to +1)', fontsize=12)\n",
    "plt.legend(loc='upper left')\n",
    "plt.grid(True, which='both', linestyle='--', alpha=0.5)\n",
    "\n",
    "# Interpretation: \n",
    "# The x-axis represents the market timeline. \n",
    "# The y-axis quantifies the daily net directional bias of StockTwits users.\n",
    "# Persistent deviations above the zero-line suggest 'Crowd Optimism' regimes,\n",
    "# while dips below zero indicate surges in 'Crowd Anxiety' or 'Fear'.\n",
    "plt.show()"
