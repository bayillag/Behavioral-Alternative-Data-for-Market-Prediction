    "import pandas as pd\n",
    "import os\n",
    "\n",
    "# 1. DATA INGESTION: Dynamic Path Resolution\n",
    "# Behavioral datasets on Kaggle are often nested in unique directories.\n",
    "# We utilize os.walk to ensure the pipeline is portable across environments.\n",
    "TARGET_FILENAME = 'SPY_stocktwits_messages.csv'\n",
    "data_path = \"\"\n",
    "\n",
    "for root, dirs, files in os.walk('/kaggle/input'):\n",
    "    if TARGET_FILENAME in files:\n",
    "        data_path = os.path.join(root, TARGET_FILENAME)\n",
    "        break\n",
    "\n",
    "if not data_path:\n",
    "    raise FileNotFoundError(f\"Missing behavioral dataset: {TARGET_FILENAME}. Please ensure the data is attached to the notebook.\")\n",
    "\n",
    "df = pd.read_csv(data_path)\n",
    "\n",
    "# 2. SPATIOTEMPORAL SYNCHRONIZATION \n",
    "# High-frequency behavioral signals must be localized to the primary exchange timezone \n",
    "# (NYSE: America/New_York) to identify intraday lead-lag relationships.\n",
    "print(\"Synchronizing timestamps with New York market sessions...\")\n",
    "\n",
    "# Step A: Convert Unix epoch (milliseconds) to UTC\n",
    "df['DateTime_UTC'] = pd.to_datetime(df['Timestamp'], unit='ms', utc=True)\n",
    "\n",
    "# Step B: Align with Eastern Time (localizing for Daylight Savings Time)\n",
    "df['Market_Time'] = df['DateTime_UTC'].dt.tz_convert('America/New_York')\n",
    "\n",
    "# 3. SIGNAL IMPUTATION & QUALITY STANDARDIZATION\n",
    "# Nontraditional datasets suffer from inherent sparsity. We standardize unlabelled \n",
    "# discourse as 'Neutral' to maintain a continuous and mathematically tractable feature space.\n",
    "print(\"Standardizing sentiment features and mitigating data sparsity...\")\n",
    "df['Sentiment'] = df['Sentiment'].fillna('Neutral')\n",
